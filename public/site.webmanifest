{
  "name": "LanternPDF",
  "short_name": "LanternPDF",
  "description": "Free online PDF editor and tools. Your files stay in your browser.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#f6f4ef",
  "theme_color": "#f6f4ef",
  "icons": [
