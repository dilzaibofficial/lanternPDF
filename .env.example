# Copy to `.env` and adjust. All values are optional: the defaults below work out of the box.
# The browser app needs NO environment variables; these configure the optional self-hostable server.

# --- HTTP ---------------------------------------------------------------------------------
# Port the Node server listens on (serves the built web app and the /api routes).
PORT=8787
# Interface to bind. Use 0.0.0.0 inside containers.
HOST=127.0.0.1
# Comma-separated list of browser origins allowed to call /api from another origin.
# Leave empty when the web app and the API share an origin (the default setup).
ALLOWED_ORIGINS=
# Set to 1 when running behind a reverse proxy so rate limiting sees the real client IP.
TRUST_PROXY=0

# --- Upload limits (enforced by the server; the browser app reads them from /api/capabilities)
# Largest single upload, in megabytes.
MAX_UPLOAD_MB=50
# Maximum requests per client per minute across /api/convert and /api/compress.
RATE_LIMIT_PER_MINUTE=30
# Maximum number of conversions that run at the same time (each uses CPU and memory).
MAX_CONCURRENT_JOBS=2

# --- Temporary files ----------------------------------------------------------------------
# Where uploads and conversion output live while a job runs. Defaults to the OS temp dir.
# Files are deleted as soon as the response finishes; a sweeper removes stragglers.
TEMP_DIR=
# Anything older than this many minutes is removed by the sweeper (crash recovery).
FILE_RETENTION_MINUTES=15

# --- Optional converters (leave empty to auto-detect from PATH) --------------------------
# LibreOffice: enables Word/Excel/PowerPoint -> PDF and the "layout" PDF -> Word/PowerPoint mode.
#   Windows example: C:\Program Files\LibreOffice\program\soffice.exe
#   Linux example:   /usr/bin/soffice
SOFFICE_PATH=
# Ghostscript: enables the optional "stronger compression" mode.
#   Windows example: C:\Program Files\gs\gs10.04.0\bin\gswin64c.exe
#   Linux example:   /usr/bin/gs
GHOSTSCRIPT_PATH=
# Hard stop for a single conversion, in seconds. The process is killed when exceeded.
CONVERSION_TIMEOUT_SECONDS=120